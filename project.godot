; Engine configuration file.
; Projeto GuardiPatas — Godot 4.7 (GDScript), renderizador Compatibility (OpenGL ES 3).

config_version=5

[application]

config/name="GuardiPatas"
config/description="Desenhe linhas para proteger bichinhos fofos de insetos travessos."
config/version="0.6.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.996, 0.949, 0.851, 1)
boot_splash/show_image=false
config/icon="res://assets/icon/icon_512.png"
config/quit_on_go_back=false

[audio]

driver/mix_rate=44100

[autoload]

Sfx="*res://src/autoload/sfx.gd"
LevelDB="*res://src/autoload/level_db.gd"
Store="*res://src/autoload/store.gd"
Game="*res://src/autoload/game.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[internationalization]

locale/translations=PackedStringArray("res://data/i18n/translations.pt_BR.translation", "res://data/i18n/translations.en.translation", "res://data/i18n/translations.es.translation")
locale/fallback="pt_BR"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
2d/solver/solver_iterations=20

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.996, 0.949, 0.851, 1)
